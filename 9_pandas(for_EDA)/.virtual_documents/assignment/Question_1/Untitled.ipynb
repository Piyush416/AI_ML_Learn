import pandas as pd


df = pd.read_csv("IRIS.csv")





df.head(10)
df.shape
df.dtypes
df.describe()





filter_df = df[(df["petal_length"] > 4.5) & (df["species"].str.lower() == "iris-virginica")]
filter_df.head()





df.groupby("species").agg(
    avg_sepal_length = ("sepal_length","mean"),
    max_petal_width = ("petal_width", "max"),
    std_sepal_width = ("sepal_width","std"))





df2 = df.copy()
df2["petal_ratio"] = df2["petal_length"]/df2["petal_width"]
df2.groupby("species")["petal_ratio"].mean()



