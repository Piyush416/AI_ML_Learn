# Kaggle is a website which provide real dataset 
# we download the dataset => https://www.kaggle.com/datasets/smeet888/global-air-quality-data15-days-hourly-50-cities?resource=download


import pandas as pd


# AQI Data set 
df = pd.read_csv("5.1_globalAirQuality.csv")

df.head()
df.tail()
df.describe()  # we get the minimum AQI is -> 16 and maximum AQI is -> 231


# Selecting Data

# Columns select
df.columns
df['city']
df[['city', 'aqi']]

# rows select using label loc=>location
df.loc[0]
df.loc[0:2]  # start idx : end idx(inclusive) in label

# rows select using index iloc => index location
df.iloc[0]
df.iloc[0:2]  # start index : end idx(exclusive) in index


# Cells -> row,columns
df.loc[0, 'city']
df.loc[0:2, ['city','aqi']]
# df.iloc[0:2, ['city', 'aqi']] #this through error becuase iloc required numberic indexers for ['city','aqi']
df.iloc[0:2, 1:5]
df.iloc[0:2 , [1,2,11]]

# cell
df.at[0, 'city']
df.iat[0, 1]


# return view or copy
cities = df['city'].copy()  #view => so we use copy function to get copy 
cities[0] = 'Mumbai'
cities



df


# Filtering Data
df[(df['aqi']>100) & (df['temperature']<30)]

# and => &
# or  => |
# not => ~

aqi_data = df[ (df['aqi']>100) & (df['temperature'] > 30) ][ ['city','aqi'] ]

aqi_data
aqi_data.iloc[0]
# aqi_data.loc[0] #through error because label start from 6
aqi_data.loc[6]


# Filtering Data using query method -> return copy
df.query('aqi > 100 & temperature >= 30')[['city','aqi']]

# use varibale in string
aqi_val = 100
df.query('aqi > @aqi_val & temperature >= 30')[['city','aqi']]
# but always use copy method 
aqi_data = df.query('aqi > @aqi_val & temperature >= 30')[['city','aqi']].copy()
aqi_data





